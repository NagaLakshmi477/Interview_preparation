
# Base image
FROM ubuntu:22.04

# Set working directory
WORKDIR /app

# Combine multiple commands into a single RUN instruction
RUN apt-get update && \
    apt-get install -y curl wget vim && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Create application files directory
RUN mkdir -p /app/logs

# Default command
CMD ["bash"]
